{
  "name": "clubapp-arg",
  "version": "1.0.0",
  "description": "ClubApp Arg - Multi-tenant sports club management platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm run -r dev",
    "build": "pnpm run -r build",
    "api:dev": "pnpm --filter api start:dev",
    "db:sync": "pnpm --filter api db:sync",
    "db:reset": "pnpm --filter api db:reset",
    "web:dev": "pnpm --filter web dev",
    "web-v2:dev": "pnpm --filter web-v2 dev",
    "mobile:dev": "pnpm --filter mobile start",
    "test": "pnpm run -r test",
    "lint": "pnpm run -r lint"
  },
  "dependencies": {},
  "devDependencies": {}
}
