{
  "name": "clubapp-arg",
  "version": "1.0.0",
  "description": "ClubApp Arg - Multi-tenant sports club management platform",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "api:dev": "pnpm --filter @clubapp/api dev",
    "web:dev": "pnpm --filter web dev",
    "mobile:dev": "pnpm --filter mobile start",
    "type-check": "pnpm -r --if-present type-check",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint"
  },
  "dependencies": {},
  "devDependencies": {}
}
