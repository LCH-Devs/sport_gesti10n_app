DATABASE_URL=postgresql://clubapp:clubapp@localhost:5432/clubapp?schema=public
JWT_SECRET=cambialo-en-produccion-clubapp-jwt
PORT=3001
# Apex del panel. Los subdominios de club (*.localhost / TENANT_BASE_DOMAIN) se permiten solos.
# Si falta, se usa WEB_APP_URL. Nunca dejar vacío a propósito: ya no se abre CORS a cualquier origen.
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_APP_URL=http://localhost:3000
# Dominio base de los subdominios de club (local: localhost → club-prueba.localhost)
TENANT_BASE_DOMAIN=localhost
NEXT_PUBLIC_WEB_URL=http://localhost:3000
NEXT_PUBLIC_TENANT_BASE_DOMAIN=localhost
# Solo local/dev. En NODE_ENV=production se ignora (no hay atajo de soporte).
PLATFORM_MASTER_PASSWORD=clubapp-master-dev

# Mail (si faltan, el alta usa stub y muestra el texto para copiar)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ClubApp Arg <noreply@clubapp.com.ar>"

# ImageKit (logos en CDN). Sin private key, en local se guarda en disco.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/clubapp/logos
# FIREBASE_PROJECT_ID=

# --- Solo tu máquina (el default del equipo sigue siendo Webpack) ---
# 1 = Next Turbopack: cambia más rápido de sección en local. pnpm web:dev (no pnpm dev).
# WEB_DEV_TURBO=1
# 1 = no abrir Chrome al levantar el front
# WEB_NO_OPEN=1
# Defender / OneDrive: excluí node_modules y apps/web/.next (no se configura por env).
